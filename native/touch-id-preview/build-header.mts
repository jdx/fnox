import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { themeHeader } from "./theme.mts";
import { createFingerprintNativeHeader } from "./native.mts";

export function generateHeaders(outputDirectory: string): string[] {
  if (!outputDirectory)
    throw new Error("Usage: build-header.mts OUTPUT_DIRECTORY");
  fs.mkdirSync(outputDirectory, { recursive: true });
  const svg = fs.readFileSync(
    new URL("./assets/geometry.svg", import.meta.url),
    "utf8",
  );
  const flow = JSON.parse(
    fs.readFileSync(new URL("./assets/flow.json", import.meta.url), "utf8"),
  );
  const icons = [
    ["copy", "kDetailCopyIconSvg"],
    ["check", "kDetailCheckIconSvg"],
    ["logo", "kPreviewLogoSvg"],
  ];
  const declarations = icons.map(([name, symbol]) => {
    const bytes = fs.readFileSync(
      new URL(`./assets/${name}.svg`, import.meta.url),
    );
    return `static constexpr unsigned char ${symbol}[] = {${Array.from(bytes, (byte) => `0x${byte.toString(16).padStart(2, "0")}`).join(",")}};`;
  });
  const headers = {
    "fingerprint-animation.generated.h": createFingerprintNativeHeader(
      svg,
      flow,
    ),
    "theme.generated.h": themeHeader(),
    "detail-copy-icons.generated.h":
      "// Generated by build-header.mts. Do not edit.\n#pragma once\n" +
      declarations.join("\n") +
      "\n",
  };
  return Object.entries(headers).map(([name, content]) => {
    const destination = path.join(outputDirectory, name);
    fs.writeFileSync(destination, content);
    return destination;
  });
}

if (
  process.argv[1] &&
  path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)
)
  generateHeaders(process.argv[2] ?? "");
