amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["prettier"] = (Builtins.prettier) {
        exclude = List("CLAUDE.md", "CHANGELOG.md") // TODO: fix symbolic links with prettier built-in: ([error] Explicitly specified pattern "CLAUDE.md" is a symbolic link.)
    }
    ["cargo-fmt"] = Builtins.cargo_fmt
    ["cargo-clippy"] = (Builtins.cargo_clippy) {
        check = "cargo clippy -q -- -D warnings"
    }
    // hk 2's shfmt and shellcheck builtins select files with `match_any`, which
    // cannot be combined with a top-level `glob`. Replacing the selector list
    // keeps the same file set these steps matched under hk 1: *.bats in
    // addition to *.sh and *.bash, and nothing else.
    ["shfmt"] = (Builtins.shfmt) {
        match_any = List(new FileSelector {
            glob = List("**/*.bats", "**/*.sh", "**/*.bash")
        })
    }
    ["shellcheck"] = (Builtins.shellcheck) {
        match_any = List(new FileSelector {
            glob = List("**/*.bats", "**/*.sh", "**/*.bash")
        })
    }

    // define a custom linter
    ["pkl"] {
        glob = "*.pkl"
        check = "pkl eval {{files}} >/dev/null"
    }
}

fail_fast = false

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    //["pre-push"] {
    // steps = linters
    //}
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
