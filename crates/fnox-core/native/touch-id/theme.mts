import { contrastRatio, luminance, transformLightColor } from "./color.mts";

const COLORS = Object.freeze({
  slate: "#323c4a",
  blue: "#637a8e",
  gold: "#d4af37",
  brightGold: "#e5bf52",
  paleGold: "#edcc75",
  heading: "#edeff5",
  text: "#eeeee9",
  midnight: "#0a0e1a",
  ribbonBlue: "#7ed7f4",
});

// Semantic roles: dark mode is the source palette, not a separate light palette.
export const DARK_THEME = Object.freeze({
  resting: COLORS.slate,
  border: COLORS.slate,
  incoming: COLORS.blue,
  accent: COLORS.gold,
  check: COLORS.brightGold,
  highlight: COLORS.paleGold,
  heading: COLORS.heading,
  cancelText: COLORS.text,
  pressed: COLORS.midnight,
  ribbon: COLORS.ribbonBlue,
  success: COLORS.gold,
  trail: COLORS.paleGold,
  shimmer: COLORS.paleGold,
});
export type ThemeRole = keyof typeof DARK_THEME;
export type Theme = Readonly<Record<ThemeRole, string>>;
const THEME_ROLES = Object.keys(DARK_THEME) as ThemeRole[];

export const LIGHT_RULES = Object.freeze({
  matte: "#fcfbf8",
  minimumContrast: 4.5,
  offsetStep: 0.005,
  minimumOffset: -0.3,
  controlReferenceOffset: -0.035,
  restingOffset: 0.16,
  incomingOffset: -0.09,
  trailOffset: -0.035,
});

export function readableColor(
  source: string,
  background: string,
  startOffset = 0,
): string {
  const steps = Math.floor(
    (startOffset - LIGHT_RULES.minimumOffset) / LIGHT_RULES.offsetStep,
  );
  for (let step = 0; step <= steps; step++) {
    const color = transformLightColor(
      source,
      startOffset - step * LIGHT_RULES.offsetStep,
    );
    if (contrastRatio(background, color) >= LIGHT_RULES.minimumContrast)
      return color;
  }
  throw new Error(
    `Cannot derive a readable color from ${source} against ${background}`,
  );
}

export function deriveLightTheme(): Theme {
  const theme = Object.fromEntries(
    THEME_ROLES.map((role) => [role, transformLightColor(DARK_THEME[role])]),
  ) as Record<ThemeRole, string>;

  const controlReference = transformLightColor(
    DARK_THEME.resting,
    LIGHT_RULES.controlReferenceOffset,
  );
  theme.incoming = transformLightColor(
    DARK_THEME.resting,
    LIGHT_RULES.incomingOffset,
  );
  theme.trail = transformLightColor(
    DARK_THEME.incoming,
    LIGHT_RULES.trailOffset,
  );

  // Blue working states avoid turning inverted brand gold into muddy brown.
  for (const role of [
    "accent",
    "highlight",
    "heading",
    "cancelText",
  ] as const) {
    const source =
      role === "accent" || role === "highlight"
        ? DARK_THEME.incoming
        : DARK_THEME[role];
    theme[role] = readableColor(source, controlReference);
  }
  theme.border = readableColor(DARK_THEME.border, LIGHT_RULES.matte);
  theme.shimmer = readableColor(
    DARK_THEME.resting,
    LIGHT_RULES.matte,
    LIGHT_RULES.incomingOffset,
  );

  // Resting ridges soften the same neutral source used for Cancel text.
  theme.resting = transformLightColor(
    DARK_THEME.cancelText,
    LIGHT_RULES.restingOffset,
  );

  // Preserve the approved blue success state independently of the resting neutral.
  const darkest = [theme.incoming, theme.trail].reduce((first, second) =>
    luminance(second) < luminance(first) ? second : first,
  );
  theme.success = darkest;
  theme.check = darkest;
  return Object.freeze(theme);
}

export const LIGHT_THEME = deriveLightTheme();

export function themeHeader(): string {
  const declarations = THEME_ROLES.map((role) => {
    const name = role[0]!.toUpperCase() + role.slice(1);
    return `constexpr uint32_t kTheme${name}[2] = {0x${LIGHT_THEME[role].slice(1)}, 0x${DARK_THEME[role].slice(1)}};`;
  });
  return [
    "// Generated by build-header.mts. Do not edit.",
    "#pragma once",
    "#include <cstdint>",
    "namespace fnox {",
    ...declarations,
    "} // namespace fnox",
    "",
  ].join("\n");
}
