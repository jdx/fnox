{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>jdx/renovate-config"],
  "ignoreDeps": [
    "aws-config",
    "aws-sdk-kms",
    "aws-sdk-secretsmanager",
    "aws-sdk-ssm",
    "aws-sdk-sts"
  ],
  "packageRules": [
    {
      "description": "The perf-runner image sets the toolchain every perf baseline is measured on; review bumps instead of automerging them.",
      "matchPackageNames": ["ghcr.io/jdx/perf-runner"],
      "automerge": false
    }
  ]
}
