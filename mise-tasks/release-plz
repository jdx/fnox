#!/usr/bin/env bash
# shellcheck shell=bash
set -euxo pipefail

DRY_RUN="${DRY_RUN:-0}"

# --- publish helpers ---
# Seconds between polls of the crates.io index, polls before giving up, pause
# between failed `cargo publish` attempts. Overridable for tests.
POLL_SECS="${POLL_SECS:-15}"
POLL_ATTEMPTS="${POLL_ATTEMPTS:-40}"
RETRY_SECS="${RETRY_SECS:-60}"

# Path of a crate in the crates.io sparse index.
index_path() {
  local crate="$1"
  case "${#crate}" in
  1) echo "1/$crate" ;;
  2) echo "2/$crate" ;;
  3) echo "3/${crate:0:1}/$crate" ;;
  *) echo "${crate:0:2}/${crate:2:2}/$crate" ;;
  esac
}

# Succeeds if `crate` at `version` is in the crates.io sparse index, the index
# cargo itself resolves dependencies from. A 404 means the crate is unknown;
# transient errors are retried and then fail the script, so an outage is never
# mistaken for "not published" and publishes nothing blindly.
published() {
  local crate="$1" version="$2" attempt code found
  local body
  body="$(mktemp)"
  for attempt in 1 2 3 4; do
    # The index body goes to a file so `set -x` does not print it.
    code="$(curl -sS --max-time 30 -o "$body" -w '%{http_code}' "https://index.crates.io/$(index_path "$crate")")" || code=000
    case "$code" in
    200)
      found=1
      grep -q "\"vers\":\"$version\"" "$body" || found=0
      rm -f "$body"
      [ "$found" = 1 ]
      return
      ;;
    404)
      rm -f "$body"
      return 1
      ;;
    esac
    echo "crates.io index returned $code for $crate (attempt $attempt)" >&2
    sleep "$POLL_SECS"
  done
  rm -f "$body"
  echo "error: cannot read the crates.io index for $crate; not publishing blindly" >&2
  exit 1
}

# Waits until `crate` at `version` is visible in the index.
wait_published() {
  local crate="$1" version="$2" attempt
  for ((attempt = 1; attempt <= POLL_ATTEMPTS; attempt++)); do
    if published "$crate" "$version"; then
      return 0
    fi
    echo "waiting for $crate $version to appear in the crates.io index ($attempt/$POLL_ATTEMPTS)" >&2
    sleep "$POLL_SECS"
  done
  echo "error: $crate $version is still not in the crates.io index" >&2
  exit 1
}

# The workspace crates a crate depends on, which must be published first.
workspace_deps() {
  case "$1" in
  fnox-core) echo "fnox-client" ;;
  fnox) echo "fnox-core fnox-client" ;;
  esac
}

# Publishes one crate: waits for its workspace dependencies to be visible in
# the index (cargo verifies against the index, which lags an upload by a while),
# retries a failed publish after re-checking that it did not upload anyway,
# then waits for the crate itself to be visible.
publish_crate() {
  local crate="$1" version="$2" dep attempt
  for dep in $(workspace_deps "$crate"); do
    wait_published "$dep" "$version"
  done
  for attempt in 1 2 3; do
    if cargo publish -p "$crate"; then
      break
    fi
    if published "$crate" "$version"; then
      break
    fi
    if [ "$attempt" = 3 ]; then
      echo "error: cargo publish -p $crate failed $attempt times" >&2
      exit 1
    fi
    sleep "$RETRY_SECS"
  done
  wait_published "$crate" "$version"
}

# Publishes every workspace crate whose current version is not on crates.io,
# dependencies first, so an interrupted release is completed by the next run.
publish_missing() {
  local crate version
  for crate in fnox-client fnox-core fnox; do
    version="$(cargo pkgid "$crate" | cut -d# -f2 | cut -d@ -f2)"
    if published "$crate" "$version"; then
      echo "$crate $version is already published"
      continue
    fi
    if [ "$DRY_RUN" != 0 ]; then
      echo "would publish $crate $version"
      continue
    fi
    publish_crate "$crate" "$version"
  done
}
# --- end publish helpers ---

released_versions="$(git tag --list | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$' || true)"
cur_version="$(cargo pkgid fnox | cut -d# -f2 | cut -d@ -f2)"
if [ -z "$released_versions" ] || ! echo "$released_versions" | grep -q "^v$cur_version$"; then
  echo "Releasing $cur_version"
  if [ "${DRY_RUN:-}" == 0 ]; then
    # Only create and push the tag - let the release workflow handle creating the release
    git tag "v$cur_version"
    git push --tags
  fi
  # Publish fnox-client, then fnox-core, then fnox: fnox-core depends on
  # fnox-client, and fnox on both, via path + version, so each publish
  # requires its dependencies at this version in the crates.io index. An upload
  # takes a while to appear there, and cargo does not wait for it, so
  # publish_missing waits itself.
  publish_missing
  exit 0
fi

# The tag exists, but a previous run may have been interrupted before every
# crate was published (the tag is pushed first). Publish what is missing.
publish_missing

version="$(git cliff --bumped-version)"

if [ "$DRY_RUN" -ne 0 ]; then
  echo "version: $version"
  echo "changelog: $(git cliff --bump --unreleased --strip all | tail -n +3)"
  exit 0
fi

# If there is no new version to bump (i.e., equal to current), skip creating a release PR
if [ "$version" = "v$cur_version" ]; then
  echo "No unreleased changes detected for fnox; skipping release PR creation."
  exit 0
fi

# Bump the workspace version; `fnox`, `fnox-core` and `fnox-client` all inherit
# it via `version.workspace = true`. Like `cargo set-version --workspace`, also
# move the major-only `fnox-client` requirement in `[workspace.dependencies]`
# and fnox's `fnox-core` requirement to the new major. Done with sed because
# cargo-edit has no prebuilt binary and compiling it slowed every CI job.
target_version="${version#v}"
# Also keeps sed metacharacters out of the replacements below.
if ! [[ "$target_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$ ]]; then
  echo "error: unexpected version from git cliff: $version" >&2
  exit 1
fi
sed -i.bak \
  -e "/^\[workspace\.package\]/,/^\[/ s/^\(version[[:space:]]*=[[:space:]]*\)\"[^\"]*\"/\1\"$target_version\"/" \
  -e "s/^\(fnox-core[[:space:]]*=[[:space:]]*{.*version[[:space:]]*=[[:space:]]*\"\)[0-9][0-9]*\"/\1${target_version%%.*}\"/" \
  -e "s/^\(fnox-client[[:space:]]*=[[:space:]]*{.*version[[:space:]]*=[[:space:]]*\"\)[0-9][0-9]*\"/\1${target_version%%.*}\"/" \
  Cargo.toml
rm Cargo.toml.bak
# Resolving the workspace syncs the Cargo.lock entries of fnox, fnox-core and
# fnox-client without upgrading any dependency, the same lockfile effect
# `cargo set-version` had.
cargo metadata --format-version 1 >/dev/null
# sed exits 0 even when nothing matched, so confirm cargo sees the new version
# before releasing. A missed fnox-core or fnox-client requirement on a major
# bump already fails `cargo metadata` above.
for crate in fnox fnox-core fnox-client; do
  new_version="$(cargo pkgid "$crate" | cut -d# -f2 | cut -d@ -f2)"
  if [ "$new_version" != "$target_version" ]; then
    echo "error: $crate is at $new_version after the bump, expected $target_version; check [workspace.package] in Cargo.toml" >&2
    exit 1
  fi
done

git config user.name mise-en-dev
git config user.email 123107610+mise-en-dev@users.noreply.github.com
mise run render ::: lint-fix

# Generate changelog using git-cliff (LLM editorialization happens in release.yml after merge)
git cliff --bump -o CHANGELOG.md

# Get the unreleased notes for PR body
# Strip version header since PR title already has version
PR_BODY="$(git cliff --bump --unreleased --strip all | tail -n +3)"

git add \
  Cargo.* \
  CHANGELOG.md \
  docs \
  fnox.usage.kdl

git checkout -B release
git commit -m "chore: release $version"
git push origin release --force

# Try to create PR, if it already exists then edit it
if ! gh pr create --title "chore: release $version" --body "$PR_BODY"; then
  echo "Failed to create PR, attempting to update existing PR"
  gh pr edit release --title "chore: release $version" --body "$PR_BODY" || true
fi
