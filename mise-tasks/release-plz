#!/usr/bin/env bash
# shellcheck shell=bash
set -euxo pipefail

DRY_RUN="${DRY_RUN:-0}"

released_versions="$(git tag --list | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$' || true)"
cur_version="$(cargo pkgid fnox | cut -d# -f2 | cut -d@ -f2)"
# Publish order: fnox-core depends on fnox-client, and fnox on both, via path +
# version, so each needs its dependencies at this version in the crates.io index.
CRATES=(fnox-client fnox-core fnox)

# Succeeds if crate $1 at version $2 is in the crates.io sparse index, which is
# what cargo resolves dependencies from. A 404 means "not published"; any other
# failure stops the script rather than risk publishing again.
# (The index path below is for names of four or more characters.)
on_crates_io() {
  local name="$1" version="$2" body code found
  body="$(mktemp)"
  # The body goes to a file so `set -x` does not print the whole index entry.
  code="$(curl -sSL -H 'Cache-Control: no-cache' -o "$body" -w '%{http_code}' "https://index.crates.io/${name:0:2}/${name:2:2}/$name")" || code=000
  case "$code" in
  200)
    found=1
    grep -q "\"vers\":\"$version\"" "$body" || found=0
    rm -f "$body"
    [ "$found" = 1 ]
    ;;
  404)
    rm -f "$body"
    return 1
    ;;
  *)
    rm -f "$body"
    echo "error: crates.io index returned HTTP $code for $name" >&2
    exit 1
    ;;
  esac
}

# Publishes the given crates in order, skipping any already on crates.io, and
# waits for each to be visible in the index before the next. `cargo publish`
# waits only publish.timeout (60s) for that, then merely warns and succeeds,
# which let `fnox` resolve a stale `fnox-core` and fail in v1.39.0.
publish_crates() {
  local crate _
  for crate in "$@"; do
    if on_crates_io "$crate" "$cur_version"; then
      echo "$crate $cur_version is already on crates.io"
      continue
    fi
    cargo publish -p "$crate"
    for _ in $(seq 60); do
      if on_crates_io "$crate" "$cur_version"; then
        continue 2
      fi
      sleep 10
    done
    echo "error: $crate $cur_version is still not in the crates.io index" >&2
    exit 1
  done
}

# Publishes the given crates from the tag, not from whatever main has moved on
# to, and puts the checkout back afterwards, even on failure.
publish_crates_from_tag() {
  local start
  start="$(git rev-parse --abbrev-ref HEAD)"
  if [ "$start" = HEAD ]; then
    start="$(git rev-parse HEAD)"
  fi
  git checkout --quiet "v$cur_version"
  # shellcheck disable=SC2064
  trap "git checkout --quiet '$start'" EXIT
  publish_crates "$@"
  git checkout --quiet "$start"
  trap - EXIT
}

if [ -z "$released_versions" ] || ! echo "$released_versions" | grep -q "^v$cur_version$"; then
  echo "Releasing $cur_version"
  if [ "${DRY_RUN:-}" == 0 ]; then
    # Only create and push the tag - let the release workflow handle creating the release
    git tag "v$cur_version"
    git push --tags
    publish_crates "${CRATES[@]}"
  fi
  exit 0
fi

# The tag exists, but a release interrupted after the tag was pushed (it is
# pushed first) can leave crates unpublished. Finish it from the tag.
missing=()
for crate in "${CRATES[@]}"; do
  if ! on_crates_io "$crate" "$cur_version"; then
    missing+=("$crate")
  fi
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo "v$cur_version is tagged but not fully published; missing: ${missing[*]}"
  if [ "$DRY_RUN" == 0 ]; then
    publish_crates_from_tag "${missing[@]}"
  fi
fi

version="$(git cliff --bumped-version)"

if [ "$DRY_RUN" -ne 0 ]; then
  echo "version: $version"
  echo "changelog: $(git cliff --bump --unreleased --strip all | tail -n +3)"
  exit 0
fi

# If there is no new version to bump (i.e., equal to current), skip creating a release PR
if [ "$version" = "v$cur_version" ]; then
  echo "No unreleased changes detected for fnox; skipping release PR creation."
  exit 0
fi

# Bump the workspace version; `fnox`, `fnox-core` and `fnox-client` all inherit
# it via `version.workspace = true`. Like `cargo set-version --workspace`, also
# move the major-only `fnox-client` requirement in `[workspace.dependencies]`
# and fnox's `fnox-core` requirement to the new major. Done with sed because
# cargo-edit has no prebuilt binary and compiling it slowed every CI job.
target_version="${version#v}"
# Also keeps sed metacharacters out of the replacements below.
if ! [[ "$target_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$ ]]; then
  echo "error: unexpected version from git cliff: $version" >&2
  exit 1
fi
sed -i.bak \
  -e "/^\[workspace\.package\]/,/^\[/ s/^\(version[[:space:]]*=[[:space:]]*\)\"[^\"]*\"/\1\"$target_version\"/" \
  -e "s/^\(fnox-core[[:space:]]*=[[:space:]]*{.*version[[:space:]]*=[[:space:]]*\"\)[0-9][0-9]*\"/\1${target_version%%.*}\"/" \
  -e "s/^\(fnox-client[[:space:]]*=[[:space:]]*{.*version[[:space:]]*=[[:space:]]*\"\)[0-9][0-9]*\"/\1${target_version%%.*}\"/" \
  Cargo.toml
rm Cargo.toml.bak
# Resolving the workspace syncs the Cargo.lock entries of fnox, fnox-core and
# fnox-client without upgrading any dependency, the same lockfile effect
# `cargo set-version` had.
cargo metadata --format-version 1 >/dev/null
# sed exits 0 even when nothing matched, so confirm cargo sees the new version
# before releasing. A missed fnox-core or fnox-client requirement on a major
# bump already fails `cargo metadata` above.
for crate in fnox fnox-core fnox-client; do
  new_version="$(cargo pkgid "$crate" | cut -d# -f2 | cut -d@ -f2)"
  if [ "$new_version" != "$target_version" ]; then
    echo "error: $crate is at $new_version after the bump, expected $target_version; check [workspace.package] in Cargo.toml" >&2
    exit 1
  fi
done

git config user.name mise-en-dev
git config user.email 123107610+mise-en-dev@users.noreply.github.com
mise run render ::: lint-fix

# Generate changelog using git-cliff (LLM editorialization happens in release.yml after merge)
git cliff --bump -o CHANGELOG.md

# Get the unreleased notes for PR body
# Strip version header since PR title already has version
PR_BODY="$(git cliff --bump --unreleased --strip all | tail -n +3)"

git add \
  Cargo.* \
  CHANGELOG.md \
  docs \
  fnox.usage.kdl

git checkout -B release
git commit -m "chore: release $version"
git push origin release --force

# Try to create PR, if it already exists then edit it
if ! gh pr create --title "chore: release $version" --body "$PR_BODY"; then
  echo "Failed to create PR, attempting to update existing PR"
  gh pr edit release --title "chore: release $version" --body "$PR_BODY" || true
fi
